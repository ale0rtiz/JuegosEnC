#include <stdio.h>

#define FILAS 6
#define COLUMNAS 7

void inicializarTablero(char tablero[FILAS][COLUMNAS]){
    for(int i=0; i<FILAS; i++){
        for(int j=0; j<COLUMNAS; j++){
            tablero[i][j] = '*';
        }
    }
}

void mostrarTablero(char tablero[FILAS][COLUMNAS]){
    printf(" ");
    
    for(int i=0; i<COLUMNAS; i++){
        printf(" %d", i + 1);
    }
    printf("\n");
    for(int i=0; i<FILAS; i++){
        for(int j=0; j<COLUMNAS; j++){
            printf(" %c", tablero[i][j]);
        }
        printf("\n");
    }
}

int colocarFicha(char tablero[FILAS][COLUMNAS], char ficha, int columna){
    int i;
    
    if(tablero[0][columna] != ' '){
        return -1;
    }
    
    for(int i=FILAS-1; i>=0; i--){
        if(tablero[i][columna] == ' '){
            tablero[i][columna]= ficha;
            return i;
        }
    }
    return -1;
}

int verificar(char tablero[FILAS][COLUMNAS], char ficha, int fila, int columna){
    int posiciones[4][2] = {
        {0, 1}, {1, 0}, {1, 1}, {1, -1}
    };
    
    int a, e;
    int cantidades;
    int f, c;
    
    for(int a=0; a<4; a++){
        cantidades = 1;
        for(int e=0; e<4; e++){
        f = fila + e * posiciones[a][0];
        c - columna + e * posiciones[a][1];
        
        if(f>=0 && f<FILAS && c>=0 && c<COLUMNAS &&  tablero[f][c] == ficha){
            cantidades++;
        }else {
            break;
        }
        }
    }
    if(cantidades>=4){
        return 1;
    }
    return 0;
}

int tableroLleno(char tablero[FILAS][COLUMNAS]){
    for(int i=0; i<COLUMNAS; i++){
        if(tablero[0][i] == ' '){
            return 0;
        }
    }
    return 1;
}
int main()
{
    char tablero[FILAS][COLUMNAS];
    int jugador = 1;
    int columna, fila;
    char ficha;
    int FIN = 0;
    
    inicializarTablero(tablero);
    
    printf("===== \n");
    printf("𝐂𝐨𝐧𝐞𝐜𝐭𝐚 𝐂𝐮𝐚𝐭𝐫𝐨 \n");
    printf("===== \n");
    printf("Jugador/a 1: O \n");
    printf("Jugador/a 2: X \n");
    printf("El jugador que conecte 4 fichas gana \n");
    
    while(FIN == 0){
        mostrarTablero(tablero);
        
        if (jugador == 1){
            ficha = 'X';
        }else {
            ficha = 'O';
        }
        printf("Turno del jugador %d (%c) \n", jugador, ficha);
        
        if(scanf("%d", &columna) != 1){
            printf("Entrada invalida");
            for(int i=0; i<10; i++)printf("\n");
            continue;
        }
        columna--;
        
        if(columna<0 || columna>= COLUMNAS){
            printf("Columna invalida. Intenta de nuevo \n");
            continue;
        }
        
        fila = colocarFicha(tablero, columna, ficha);
        
        if(fila == -1){
            printf("La columna se encuentra llena. Intenta de nuevo \n");
            continue;
        }
        if (verificar(tablero, fila, columna, ficha)){
            mostrarTablero(tablero);
            printf("=====\n");
            printf("EL GANADOR ES EL JUGADOR/A %d (%c)\n", jugador, ficha);
            printf("=====\n");
            
            FIN = 1;
        } else if(tableroLleno(tablero)){
            mostrarTablero(tablero);
            printf("=====\n");
            printf("EMPATE %d (%c)\n", jugador, ficha);
            printf("=====\n");
            
            FIN = 1;
        }
        else{
            if(jugador == 1){
                jugador = 2;
            }else{
                jugador = 1;
            }
        }
    }
    return 0;
}
